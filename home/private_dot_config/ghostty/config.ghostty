# General Settings
gtk-single-instance=false
copy-on-select = clipboard
font-size = 14
font-family = "CodeliaLigatures Nerd Font"

# Window
gtk-titlebar-hide-when-maximized = true
fullscreen = true

# Colors & Selection
background = #282828
foreground = #ebdbb2
cursor-color = #928374
selection-background = #ebdbb2
selection-foreground = #928374

# ANSI Palette (Normal: Black, Red, Green, Yellow, Blue, Magenta, Cyan, White)
palette = 0=#665c54
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#d79921
palette = 4=#458588
palette = 5=#b16286
palette = 6=#689d6a
palette = 7=#a89984

# ANSI Palette (Bright: Black, Red, Green, Yellow, Blue, Magenta, Cyan, White)
palette = 8=#7c6f64
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2f
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#bdae93
