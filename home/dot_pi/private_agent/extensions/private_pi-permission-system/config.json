{
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": true,
  "authorizerChain": [
    "permission-judge"
  ],
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "~/.ssh/*": "deny",
      "/dev/sd*": "deny"
    },
    "bash": {
      "*": "ask",
      "cat": "allow",
      "cat *": "allow",
      "head": "allow",
      "head *": "allow",
      "tail": "allow",
      "tail *": "allow",
      "less": "allow",
      "less *": "allow",
      "more": "allow",
      "more *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "tree": "allow",
      "tree *": "allow",
      "stat": "allow",
      "stat *": "allow",
      "file": "allow",
      "file *": "allow",
      "file *-C*": "ask",
      "file *--compile*": "ask",
      "wc": "allow",
      "wc *": "allow",
      "du": "allow",
      "du *": "allow",
      "df": "allow",
      "df *": "allow",
      "grep": "allow",
      "grep *": "allow",
      "egrep": "allow",
      "egrep *": "allow",
      "fgrep": "allow",
      "fgrep *": "allow",
      "rg": "allow",
      "rg *": "allow",
      "rg *--pre*": "ask",
      "find": "allow",
      "find *": "allow",
      "find *-exec*": "ask",
      "find *-delete*": "ask",
      "find *-fprint*": "ask",
      "fd": "allow",
      "fd *": "allow",
      "fd *-exec*": "ask",
      "fd *-exec-batch*": "ask",
      "fd *-x*": "ask",
      "fd *-X*": "ask",
      "diff": "allow",
      "diff *": "allow",
      "cmp": "allow",
      "cmp *": "allow",
      "comm": "allow",
      "comm *": "allow",
      "md5sum": "allow",
      "md5sum *": "allow",
      "md5sum *-c*": "ask",
      "md5sum *--check*": "ask",
      "sha256sum": "allow",
      "sha256sum *": "allow",
      "sha256sum *-c*": "ask",
      "sha256sum *--check*": "ask",
      "git status": "allow",
      "git status *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git diff *--output*": "ask",
      "git diff *--ext-diff*": "ask",
      "git show": "allow",
      "git show *": "allow",
      "git blame": "allow",
      "git blame *": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "git branch": "allow",
      "git remote -v": "allow",
      "rm -rf *": "ask",
      "rm -fr *": "ask",
      "sudo *": "ask",
      "dd *": "ask",
      "chmod -R 777 *": "ask",
      "chown -R *": "ask",
      "git push --force*": "ask",
      "git reset --hard*": "ask",
      "npm publish*": "ask",
      "curl * | *sh": "ask",
      "wget * | *sh": "ask",
      "kubectl delete*": "ask",
      "docker system prune*": "ask",
      "mkfs*": "deny",
      ":(){ *": "deny"
    },
    "web_search": "allow",
    "source_check": "allow",
    "fetch_content": "allow",
    "get_search_content": "allow",
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow"
  }
}
